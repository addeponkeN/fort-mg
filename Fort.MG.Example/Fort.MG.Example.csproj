<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RollForward>Major</RollForward>
		<PublishReadyToRun>false</PublishReadyToRun>
		<TieredCompilation>false</TieredCompilation>
	</PropertyGroup>

	<PropertyGroup>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationIcon>Icon.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Icon.ico" />
		<None Remove="Icon.bmp" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Icon.ico">
			<LogicalName>Icon.ico</LogicalName>
		</EmbeddedResource>
		<EmbeddedResource Include="Icon.bmp">
			<LogicalName>Icon.bmp</LogicalName>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.4" />
		<PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4" />
		<PackageReference Include="Nopipeline.Task" Version="2.3.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Fort\Fort.TexturePacker\Fort.TexturePacker.csproj" />
		<ProjectReference Include="..\Fort.MG.Editor\Fort.MG.Editor.csproj" />
		<!-- Built and copied into content/ by the SyncContentPipelineExtension target below; not referenced as an assembly. -->
		<ProjectReference Include="..\Fort.MG.PipelineExtension\Fort.MG.PipelineExtension.csproj" ReferenceOutputAssembly="false" PrivateAssets="All" />
		<ProjectReference Include="..\Fort.MG.Engine\Fort.MG.Engine.csproj" />
		<ProjectReference Include="..\Fort.MG.Gui\Fort.MG.Gui.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="content\fonts\defaultfont.ttf">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	</ItemGroup>
	<!--
	  Two things the MonoGame content build needs that MSBuild does not do by itself here:

	  1. MGCB is invoked as `dotnet mgcb`, which is resolved from .config/dotnet-tools.json, so that
	     tool has to be restored. MonoGame.Content.Builder.Task only installs into its own package
	     folder, which it never uses on Windows because it probes for an extensionless `mgcb`.
	     Without this the content build fails with MSB3073 / "Run dotnet tool restore".

	  2. content/Content.mgcb references content/Fort.MG.PipelineExtension.dll, so rebuild it from
	     source and copy it next to the content instead of relying on a checked-in binary.
	-->
	<Target Name="RestoreContentBuilderTool" BeforeTargets="PrepareContentBuilder">
		<Exec Command="&quot;$(DotnetCommand)&quot; tool restore" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

	<Target Name="SyncContentPipelineExtension" BeforeTargets="PrepareContentBuilder">
		<MSBuild Projects="$(MSBuildProjectDirectory)\..\Fort.MG.PipelineExtension\Fort.MG.PipelineExtension.csproj"
		         Targets="Build"
		         Properties="Configuration=$(Configuration)">
			<Output TaskParameter="TargetOutputs" ItemName="ContentPipelineExtensionOutput" />
		</MSBuild>

		<!-- Only the extension plus its own package dependencies; MonoGame's pipeline assemblies stay owned by MGCB. -->
		<ItemGroup>
			<ContentPipelineExtensionFile Include="@(ContentPipelineExtensionOutput)" />
			<ContentPipelineExtensionFile Include="@(ContentPipelineExtensionOutput->'%(RootDir)%(Directory)RectpackSharp.dll')" />
		</ItemGroup>

		<Copy SourceFiles="@(ContentPipelineExtensionFile)"
		      DestinationFolder="$(MSBuildProjectDirectory)\content"
		      SkipUnchangedFiles="true" />
	</Target>
</Project>
